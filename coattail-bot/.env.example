# Kopieren nach .env und ausfuellen. .env steht in .gitignore und gehoert
# niemals ins Repo.

# Kontaktadresse im User-Agent. Pflicht, nicht Hoeflichkeit: die SEC sperrt
# Abrufe ohne echte Mailadresse, dann liefert sec_form4 nichts.
COATTAIL_CONTACT="dein-name (mail@example.com)"

# --- Kongress und Insider -------------------------------------------------
# Kostenlos und ohne Schluessel laufen: capitoltrades, sec_form4, sec_13f,
# federal_register, usaspending, bluesky, truthsocial, rss, hyperliquid
QUIVER_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
UNUSUALWHALES_API_KEY=
CONGRESS_GOV_API_KEY=

# --- Copy-Trading-Plattformen --------------------------------------------
INVO_API_KEY=
INVO_SESSION_COOKIE=

# --- Posts ----------------------------------------------------------------
# X kostet pro gelesenem Post (Pay-per-use, Guthaben vorab kaufen auf
# developer.x.com). Danach in config.yaml bei der Quelle x enabled: true.
X_BEARER_TOKEN=

# --- Ausfuehrung ----------------------------------------------------------
# Alpaca fuer US-Aktien. Mit dem Papierkonto anfangen.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Krypto ueber ccxt
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Auswertung und Benachrichtigung -------------------------------------
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
