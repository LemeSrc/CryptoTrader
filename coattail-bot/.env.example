# Kopieren nach .env und ausfuellen. .env steht in .gitignore und gehoert
# niemals ins Repo.

# Kontaktadresse im User-Agent. Die SEC verlangt das, andere Betreiber
# freuen sich darueber. Ohne sie steigt das Risiko einer Sperre.
COATTAIL_CONTACT="dein-name (mail@example.com)"

# --- Kongress und Insider -------------------------------------------------
# Kostenlos und ohne Schluessel laufen: stockwatcher, capitoltrades,
# sec_form4, sec_13f, federal_register, usaspending, bluesky, rss, hyperliquid
QUIVER_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
UNUSUALWHALES_API_KEY=
CONGRESS_GOV_API_KEY=

# --- Copy-Trading-Plattformen --------------------------------------------
INVO_API_KEY=
INVO_SESSION_COOKIE=

# --- Posts ----------------------------------------------------------------
X_BEARER_TOKEN=

# --- Ausfuehrung ----------------------------------------------------------
# Alpaca fuer US-Aktien. Mit dem Papierkonto anfangen.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Krypto ueber ccxt
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Auswertung und Benachrichtigung -------------------------------------
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
